<?xml version="1.0" encoding="utf-8"?>
<!--
    Root is a vertical LinearLayout: a top app bar (hamburger menu) and the
    scrolling content below it. MainActivity applies the system bar insets to
    mainRoot, so nothing is drawn under the status or navigation bars.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        android:elevation="4dp"
        app:navigationContentDescription="Menu"
        app:navigationIcon="@drawable/ic_menu">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="LoRaBlue Edge AI"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"
                android:text="Status: Disconnected"
                android:textColor="#F44336"
                android:textSize="16sp" />

            <!-- ============== -->
            <!-- CISTERN (id=1) -->
            <!-- ============== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Cistern"
                android:textColor="#555555"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardCistern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCisternWaterLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Water Level: -- m"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvCisternWaterPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="(-- %)"
                        android:textColor="#888888"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnCisternDepthConfig"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Configure Cistern depth"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_gear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCisternPump"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Water Pump: --"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvCisternBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery: -- %"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvCisternRssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="RSSI: -- dBm"
                    android:textColor="#888888"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- =========== -->
            <!-- TANK (id=2) -->
            <!-- =========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Tank"
                android:textColor="#555555"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/cardTank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTankWaterLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Water Level: -- m"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tvTankWaterPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:text="(-- %)"
                        android:textColor="#888888"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnTankDepthConfig"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Configure Tank depth"
                        android:focusable="true"
                        android:padding="6dp"
                        android:src="@drawable/ic_gear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTankBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery: -- %"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvTankRssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="RSSI: -- dBm"
                    android:textColor="#888888"
                    android:textSize="18sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:text="SCAN &amp; CONNECT" />

            <Button
                android:id="@+id/btnTxTest"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="#9E9E9E"
                android:text="TX TEST" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>